// EDU-FORUM database schema. Source of truth: PRD "Data model" + CLAUDE.md pillars.
// Conventions: UUID ids, created_at/updated_at, soft delete via deleted_at, snake_case in the
// database (@map/@@map), camelCase in code. Subject/level/qualification/certification values
// in arrays are reference-table slugs (reference rows are deactivated, never hard-deleted).
// Files are stored as private object keys (*_key); signed URLs are generated on read.
// Location = country_code, state_id, lga_id, area, address_line (private), lat, lng, geog.
// geog is a geography(Point, 4326) column filled from lat/lng by a trigger, with a GiST index
// (see the init migration SQL).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

/// Sign-up offers teacher, principal or director (user, 2026-10-31). Principals and directors
/// have the same access: view teacher profiles/CVs, post vacancies, chat with teachers.
enum UserRole {
  teacher
  principal
  director
  admin
}

enum UserStatus {
  active
  suspended
}

enum AuthTokenType {
  email_verification
  phone_otp
  password_reset
}

enum Gender {
  male
  female
  prefer_not_to_say
}

enum JobType {
  full_time
  part_time
  contract
  tutoring
}

enum SalaryPeriod {
  monthly
  annual
  hourly
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum ProfileVisibility {
  visible
  hidden
}

enum ExperienceKind {
  job
  nysc
  teaching_practice
}

enum ScanStatus {
  pending
  clean
  infected
  failed
}

enum CvMimeType {
  pdf
  doc
  docx
}

enum DocumentStatus {
  pending
  verified
  rejected
}

enum SchoolType {
  nursery
  primary
  secondary
  combined
  tertiary
  tutorial_centre
}

enum LocationVisibility {
  listed
  anonymous
}

enum VacancyStatus {
  draft
  published
  paused
  closed
}

enum VacancyCloseReason {
  filled
  cancelled
  expired
  taken_down
}

enum ApplicationStatus {
  applied
  viewed
  shortlisted
  interview
  offered
  hired
  rejected
  withdrawn
}

enum ApplicationSource {
  applied
  invited
}

enum InvitationStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

enum InterviewMode {
  in_person
  phone
  video
}

enum InterviewStatus {
  proposed
  confirmed
  rescheduled
  cancelled
  done
}

enum SavedItemType {
  vacancy
  teacher
}

enum SavedSearchScope {
  vacancies
  teachers
}

enum AlertFrequency {
  instant
  daily
  weekly
  off
}

enum NotificationChannel {
  in_app
  email
  sms
  whatsapp
}

enum ProfileViewKind {
  profile
  cv_view
  cv_download
}

enum ReportTargetType {
  teacher_profile
  vacancy
  message
  community_post
  community_comment
  blog_post
  blog_comment
}

enum ReportStatus {
  open
  resolved
  dismissed
}

enum PostStatus {
  draft
  /// Sent to an admin for approval (user, 2026-11-01: anyone registered writes, admins approve).
  pending
  published
  rejected
}

enum BlogLikeTarget {
  post
  comment
}

enum AdPageType {
  home
  job_search
  landing
  job_detail
  blog_post
}

enum UploadPurpose {
  cv
  profile_photo
  qualification_file
  certification_file
  message_attachment
  post_cover
  community_photo
  teaching_material
  exam_timetable
}

// ─────────────────────────── Reference data ───────────────────────────

model Country {
  code      String   @id @db.Char(2) // ISO 3166-1 alpha-2, e.g. NG
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  states State[]

  @@map("countries")
}

model State {
  id          String   @id @default(uuid()) @db.Uuid
  countryCode String   @map("country_code") @db.Char(2)
  name        String
  slug        String   @unique
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  country Country @relation(fields: [countryCode], references: [code])
  lgas    Lga[]

  teacherProfiles TeacherProfile[]
  vacancies       Vacancy[]
  calendarEvents  CalendarEvent[]

  @@unique([countryCode, name])
  @@map("states")
}

model Lga {
  id        String   @id @default(uuid()) @db.Uuid
  stateId   String   @map("state_id") @db.Uuid
  name      String
  slug      String // unique within its state; URLs are /jobs/{state}/{lga}
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  state State @relation(fields: [stateId], references: [id])

  teacherProfiles TeacherProfile[]
  vacancies       Vacancy[]

  @@unique([stateId, slug])
  @@map("lgas")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subjects")
}

model Level {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("levels")
}

model QualificationType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  /// Higher rank = higher qualification; used for "highest qualification" and match score.
  rank      Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  qualifications Qualification[]

  @@map("qualification_types")
}

model CertificationType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  issuer    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  certifications Certification[]

  @@map("certification_types")
}

// ─────────────────────────── Users and auth ───────────────────────────

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  /// One email holds one role type (PRD "Users and roles").
  email                String?    @unique
  phone                String?    @unique
  passwordHash         String?    @map("password_hash")
  googleId             String?    @unique @map("google_id")
  role                 UserRole
  status               UserStatus @default(active)
  emailVerifiedAt      DateTime?  @map("email_verified_at")
  phoneVerifiedAt      DateTime?  @map("phone_verified_at")
  lastLoginAt          DateTime?  @map("last_login_at")
  /// NDPA consent captured at sign-up.
  consentAcceptedAt    DateTime?  @map("consent_accepted_at")
  consentVersion       String?    @map("consent_version")
  notificationSettings Json       @default("{}") @map("notification_settings")
  suspendedReason      String?    @map("suspended_reason")
  /// DELETE /me: data is erased within 30 days of this timestamp.
  deletionRequestedAt  DateTime?  @map("deletion_requested_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")

  teacherProfile TeacherProfile?
  refreshTokens  RefreshToken[]
  authTokens     AuthToken[]

  createdVacancies       Vacancy[]                  @relation("VacancyCreatedBy")
  employerConversations  Conversation[]             @relation("ConversationEmployer")
  sentInvitations        Invitation[]               @relation("InvitationInvitedBy")
  applicationNotes       ApplicationNote[]
  statusChanges          ApplicationStatusHistory[]
  savedItems             SavedItem[]
  savedSearches          SavedSearch[]
  sentMessages           Message[]
  notifications          Notification[]
  profileViews           ProfileView[]              @relation("ProfileViewViewer")
  reports                Report[]                   @relation("ReportReporter")
  resolvedReports        Report[]                   @relation("ReportResolvedBy")
  auditLogs              AuditLog[]
  reviewedCertifications Certification[]            @relation("CertificationReviewedBy")
  uploads                Upload[]
  posts                  Post[]
  blogComments           BlogComment[]
  blogLikes              BlogLike[]
  blockedConversations   Conversation[]             @relation("ConversationBlockedBy")
  communityPosts         CommunityPost[]
  communityComments      CommunityComment[]
  communityLikes         CommunityLike[]
  communityBlocks        CommunityBlock[]           @relation("CommunityBlocker")
  communityBlockedBy     CommunityBlock[]           @relation("CommunityBlocked")
  contactMessages        ContactMessage[]
  pushSubscriptions      PushSubscription[]
  teachingMaterials      TeachingMaterial[]
  calendarEvents         CalendarEvent[]
  examTimetables         ExamTimetable[]

  @@index([role, status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  /// Rotation: every refresh issues a new token in the same family; reuse revokes the family.
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Email verification links, phone OTPs and password reset tokens (stored hashed).
model AuthToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       AuthTokenType
  tokenHash  String        @map("token_hash")
  attempts   Int           @default(0)
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
  @@map("auth_tokens")
}

// ─────────────────────────── Uploads ───────────────────────────

/// Every file uploaded through POST /uploads/sign. Nothing is shown to others until scan is clean.
model Upload {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  purpose     UploadPurpose
  objectKey   String        @unique @map("object_key")
  fileName    String        @map("file_name")
  mimeType    String        @map("mime_type")
  sizeBytes   Int           @map("size_bytes")
  scanStatus  ScanStatus    @default(pending) @map("scan_status")
  scannedAt   DateTime?     @map("scanned_at")
  confirmedAt DateTime?     @map("confirmed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  message        Message?
  communityPhoto CommunityPhoto?
  postCover      Post?
  material       TeachingMaterial?
  timetable      ExamTimetable?

  @@index([userId, purpose])
  @@map("uploads")
}

// ─────────────────────────── Teachers ───────────────────────────

model TeacherProfile {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @unique @map("user_id") @db.Uuid
  fullName String?   @map("full_name")
  gender   Gender?
  dob      DateTime? @db.Date
  photoKey String?   @map("photo_key")
  bio      String?

  // Location (required to publish). address_line, lat, lng are never returned to principals/directors.
  countryCode String?                                @map("country_code") @db.Char(2)
  stateId     String?                                @map("state_id") @db.Uuid
  lgaId       String?                                @map("lga_id") @db.Uuid
  area        String?
  addressLine String?                                @map("address_line")
  lat         Float?
  lng         Float?
  geog        Unsupported("geography(Point, 4326)")?

  willingToRelocate       Boolean            @default(false) @map("willing_to_relocate")
  preferredStates         String[]           @default([]) @map("preferred_states") // state slugs
  subjects                String[]           @default([]) // subject slugs
  levels                  String[]           @default([]) // level slugs
  jobTypes                JobType[]          @default([]) @map("job_types")
  expectedSalaryMin       Int?               @map("expected_salary_min")
  expectedSalaryMax       Int?               @map("expected_salary_max")
  availableFrom           DateTime?          @map("available_from") @db.Date
  /// Fresh graduate: explicit "no experience yet" (requires an NYSC/teaching-practice entry).
  noExperienceYet         Boolean            @default(false) @map("no_experience_yet")
  /// Computed from WorkExperience rows by the service on every change.
  yearsExperience         Float              @default(0) @map("years_experience")
  completenessScore       Int                @default(0) @map("completeness_score")
  /// Last completed onboarding step, for the resumable wizard.
  onboardingSteps         String[]           @default([]) @map("onboarding_steps")
  verificationStatus      VerificationStatus @default(unverified) @map("verification_status")
  isPublished             Boolean            @default(false) @map("is_published")
  publishedAt             DateTime?          @map("published_at")
  visibility              ProfileVisibility  @default(visible)
  /// Set by admin unpublish (moderation) with a reason.
  moderationNote          String?            @map("moderation_note")
  /// "Finish your profile" reminders: 3 days after sign-up, then weekly, at most 3.
  incompleteRemindersSent Int                @default(0) @map("incomplete_reminders_sent")
  incompleteRemindedAt    DateTime?          @map("incomplete_reminded_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  deletedAt               DateTime?          @map("deleted_at")

  user  User   @relation(fields: [userId], references: [id])
  state State? @relation(fields: [stateId], references: [id])
  lga   Lga?   @relation(fields: [lgaId], references: [id])

  qualifications Qualification[]
  certifications Certification[]
  experiences    WorkExperience[]
  cvs            Cv[]
  applications   Application[]
  invitations    Invitation[]
  conversations  Conversation[]
  profileViews   ProfileView[]

  @@index([isPublished, visibility, verificationStatus])
  @@index([stateId, lgaId])
  @@index([subjects], type: Gin)
  @@index([levels], type: Gin)
  @@index([geog], type: Gist)
  @@map("teacher_profiles")
}

model Qualification {
  id                  String    @id @default(uuid()) @db.Uuid
  teacherId           String    @map("teacher_id") @db.Uuid
  qualificationTypeId String    @map("qualification_type_id") @db.Uuid
  course              String
  institution         String
  yearObtained        Int       @map("year_obtained")
  fileKey             String?   @map("file_key")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  teacher TeacherProfile    @relation(fields: [teacherId], references: [id])
  type    QualificationType @relation(fields: [qualificationTypeId], references: [id])

  @@index([teacherId])
  @@map("qualifications")
}

model Certification {
  id                  String         @id @default(uuid()) @db.Uuid
  teacherId           String         @map("teacher_id") @db.Uuid
  certificationTypeId String         @map("certification_type_id") @db.Uuid
  issuer              String
  number              String
  issuedAt            DateTime?      @map("issued_at") @db.Date
  expiresAt           DateTime?      @map("expires_at") @db.Date
  fileKey             String?        @map("file_key")
  verificationStatus  DocumentStatus @default(pending) @map("verification_status")
  reviewedById        String?        @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?      @map("reviewed_at")
  rejectionReason     String?        @map("rejection_reason")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  teacher    TeacherProfile    @relation(fields: [teacherId], references: [id])
  type       CertificationType @relation(fields: [certificationTypeId], references: [id])
  reviewedBy User?             @relation("CertificationReviewedBy", fields: [reviewedById], references: [id])

  @@index([teacherId])
  @@index([certificationTypeId, verificationStatus])
  @@map("certifications")
}

model WorkExperience {
  id          String         @id @default(uuid()) @db.Uuid
  teacherId   String         @map("teacher_id") @db.Uuid
  kind        ExperienceKind @default(job)
  schoolName  String         @map("school_name")
  role        String
  subjects    String[]       @default([])
  levels      String[]       @default([])
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime?      @map("end_date") @db.Date
  isCurrent   Boolean        @default(false) @map("is_current")
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  teacher TeacherProfile @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@map("work_experiences")
}

/// One active CV per teacher (partial unique index in migration SQL); old versions kept 90 days.
model Cv {
  id         String     @id @default(uuid()) @db.Uuid
  teacherId  String     @map("teacher_id") @db.Uuid
  objectKey  String     @map("object_key")
  /// DOC/DOCX converted to PDF on upload for the CV viewer.
  pdfKey     String?    @map("pdf_key")
  fileName   String     @map("file_name")
  mimeType   CvMimeType @map("mime_type")
  sizeBytes  Int        @map("size_bytes")
  isActive   Boolean    @default(false) @map("is_active")
  scanStatus ScanStatus @default(pending) @map("scan_status")
  uploadedAt DateTime   @default(now()) @map("uploaded_at")
  /// Set when replaced; purge job deletes the file 90 days after this.
  replacedAt DateTime?  @map("replaced_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  snapshots CvSnapshot[]

  @@index([teacherId, isActive])
  @@map("cvs")
}

/// Immutable copy of the CV sent with an application; survives CV replacement and the 90-day purge.
model CvSnapshot {
  id         String     @id @default(uuid()) @db.Uuid
  sourceCvId String?    @map("source_cv_id") @db.Uuid
  objectKey  String     @map("object_key")
  pdfKey     String?    @map("pdf_key")
  fileName   String     @map("file_name")
  mimeType   CvMimeType @map("mime_type")
  sizeBytes  Int        @map("size_bytes")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  sourceCv     Cv?           @relation(fields: [sourceCvId], references: [id], onDelete: SetNull)
  applications Application[]

  @@map("cv_snapshots")
}

// ─────────────────────────── Vacancies ───────────────────────────

// ─────────────────────────── Vacancies ───────────────────────────

model Vacancy {
  id             String       @id @default(uuid()) @db.Uuid
  /// The principal or director who posted it.
  createdById    String       @map("created_by") @db.Uuid
  /// Typed on each vacancy; hidden in every public response when location_visibility = anonymous.
  schoolName     String?      @map("school_name")
  /// Optional (user, 2026-10-31); shown on anonymous vacancies instead of the school name.
  schoolType     SchoolType?  @map("school_type")
  /// SEO URL is /jobs/{slug}-{shortId}; never changes once published.
  slug           String
  shortId        String       @unique @map("short_id")
  title          String
  subjects       String[]     @default([])
  levels         String[]     @default([])
  jobType        JobType      @map("job_type")
  salaryMin      Int          @map("salary_min")
  salaryMax      Int          @map("salary_max")
  salaryCurrency String       @default("NGN") @map("salary_currency") @db.Char(3)
  salaryPeriod   SalaryPeriod @default(monthly) @map("salary_period")
  /// Rich text (sanitised HTML), ≥ 100 characters of text.
  description    String

  countryCode        String                                 @default("NG") @map("country_code") @db.Char(2)
  stateId            String                                 @map("state_id") @db.Uuid
  lgaId              String                                 @map("lga_id") @db.Uuid
  area               String?
  addressLine        String?                                @map("address_line")
  lat                Float?
  lng                Float?
  geog               Unsupported("geography(Point, 4326)")?
  locationVisibility LocationVisibility                     @map("location_visibility")

  requiredQualifications String[]            @default([]) @map("required_qualifications")
  minExperienceYears     Int?                @map("min_experience_years")
  requiredCertifications String[]            @default([]) @map("required_certifications")
  openings               Int                 @default(1)
  benefits               String[]            @default([]) // accommodation, transport, feeding, hmo
  /// Up to 5: [{ id, question, type: "text" | "yes_no" }]
  screeningQuestions     Json                @default("[]") @map("screening_questions")
  deadline               DateTime?           @db.Date
  startDate              DateTime?           @map("start_date") @db.Date
  status                 VacancyStatus       @default(draft)
  publishedAt            DateTime?           @map("published_at")
  closedAt               DateTime?           @map("closed_at")
  closeReason            VacancyCloseReason? @map("close_reason")
  /// Held for admin review (moderation); rules are set in the vacancies phase.
  needsReview            Boolean             @default(false) @map("needs_review")
  takedownReason         String?             @map("takedown_reason")
  viewsCount             Int                 @default(0) @map("views_count")
  /// "Closes in 3 days" reminder sent to the poster; cleared when the deadline changes.
  expiryReminderSentAt   DateTime?           @map("expiry_reminder_sent_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  deletedAt              DateTime?           @map("deleted_at")

  createdBy User  @relation("VacancyCreatedBy", fields: [createdById], references: [id])
  state     State @relation(fields: [stateId], references: [id])
  lga       Lga   @relation(fields: [lgaId], references: [id])

  applications   Application[]
  invitations    Invitation[]
  communityPosts CommunityPost[]

  @@index([status, publishedAt])
  @@index([createdById, status])
  @@index([stateId, lgaId, status])
  @@index([subjects], type: Gin)
  @@index([levels], type: Gin)
  @@index([geog], type: Gist)
  @@map("vacancies")
}

// ─────────────────────────── Applications ───────────────────────────

model Application {
  id               String            @id @default(uuid()) @db.Uuid
  vacancyId        String            @map("vacancy_id") @db.Uuid
  teacherId        String            @map("teacher_id") @db.Uuid
  cvSnapshotId     String            @map("cv_snapshot_id") @db.Uuid
  coverNote        String?           @map("cover_note")
  /// [{ questionId, answer }]
  screeningAnswers Json              @default("[]") @map("screening_answers")
  source           ApplicationSource @default(applied)
  status           ApplicationStatus @default(applied)
  rating           Int? // 1–5 (check constraint in migration SQL)
  matchScore       Int               @default(0) @map("match_score")
  shortlistedAt    DateTime?         @map("shortlisted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  vacancy    Vacancy        @relation(fields: [vacancyId], references: [id])
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id])
  cvSnapshot CvSnapshot     @relation(fields: [cvSnapshotId], references: [id])

  history       ApplicationStatusHistory[]
  notes         ApplicationNote[]
  interviews    Interview[]
  invitation    Invitation?
  conversations Conversation[]

  /// One application per teacher per vacancy (409 on duplicate).
  @@unique([vacancyId, teacherId])
  @@index([teacherId, status])
  @@index([vacancyId, status])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  changedById   String             @map("changed_by") @db.Uuid
  message       String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id])
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

/// Private to the principal/director who wrote it.
model ApplicationNote {
  id            String    @id @default(uuid()) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  authorId      String    @map("author_id") @db.Uuid
  body          String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  application Application @relation(fields: [applicationId], references: [id])
  author      User        @relation(fields: [authorId], references: [id])

  @@index([applicationId])
  @@map("application_notes")
}

model Invitation {
  id            String           @id @default(uuid()) @db.Uuid
  vacancyId     String           @map("vacancy_id") @db.Uuid
  teacherId     String           @map("teacher_id") @db.Uuid
  invitedById   String           @map("invited_by") @db.Uuid
  message       String?
  status        InvitationStatus @default(pending)
  /// Set when accepted (accept creates an Application).
  applicationId String?          @unique @map("application_id") @db.Uuid
  respondedAt   DateTime?        @map("responded_at")
  expiresAt     DateTime?        @map("expires_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  vacancy     Vacancy        @relation(fields: [vacancyId], references: [id])
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  invitedBy   User           @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  application Application?   @relation(fields: [applicationId], references: [id])

  @@index([teacherId, status])
  @@index([vacancyId])
  @@map("invitations")
}

model Interview {
  id              String          @id @default(uuid()) @db.Uuid
  applicationId   String          @map("application_id") @db.Uuid
  scheduledAt     DateTime        @map("scheduled_at")
  durationMinutes Int?            @map("duration_minutes")
  mode            InterviewMode
  /// Address (in person), phone number, or Meet/Zoom link.
  locationOrLink  String          @map("location_or_link")
  status          InterviewStatus @default(proposed)
  /// Teacher's counter-proposal (POST /interviews/:id/propose).
  proposedAt      DateTime?       @map("proposed_at")
  proposalNote    String?         @map("proposal_note")
  notes           String?
  cancelReason    String?         @map("cancel_reason")
  /// Set when the 24-hour reminder went out; cleared on reschedule.
  reminderSentAt  DateTime?       @map("reminder_sent_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("interviews")
}

// ─────────────────────────── Saved items and searches ───────────────────────────

model SavedItem {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  itemType  SavedItemType @map("item_type")
  itemId    String        @map("item_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, itemType, itemId])
  @@map("saved_items")
}

model SavedSearch {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  scope          SavedSearchScope
  name           String?
  filters        Json
  alertFrequency AlertFrequency   @default(daily) @map("alert_frequency")
  lastAlertedAt  DateTime?        @map("last_alerted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([alertFrequency, lastAlertedAt])
  @@map("saved_searches")
}

// ─────────────────────────── Messaging ───────────────────────────

/// Opened only after shortlist or accepted invite.
model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  /// The principal or director (chat is open at any time, user 2026-10-31).
  employerId    String    @map("employer_id") @db.Uuid
  teacherId     String    @map("teacher_id") @db.Uuid
  applicationId String?   @map("application_id") @db.Uuid
  blockedById   String?   @map("blocked_by") @db.Uuid
  blockedAt     DateTime? @map("blocked_at")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  employer    User           @relation("ConversationEmployer", fields: [employerId], references: [id])
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  application Application?   @relation(fields: [applicationId], references: [id])
  blockedBy   User?          @relation("ConversationBlockedBy", fields: [blockedById], references: [id])
  messages    Message[]

  @@unique([employerId, teacherId])
  @@index([teacherId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                 String    @id @default(uuid()) @db.Uuid
  conversationId     String    @map("conversation_id") @db.Uuid
  senderId           String    @map("sender_id") @db.Uuid
  body               String?
  attachmentKey      String?   @map("attachment_key")
  attachmentName     String?   @map("attachment_name")
  attachmentMime     String?   @map("attachment_mime")
  attachmentSize     Int?      @map("attachment_size")
  /// The upload row: its scan_status decides when the attachment can be opened.
  attachmentUploadId String?   @unique @map("attachment_upload_id") @db.Uuid
  readAt             DateTime? @map("read_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  conversation     Conversation @relation(fields: [conversationId], references: [id])
  sender           User         @relation(fields: [senderId], references: [id])
  attachmentUpload Upload?      @relation(fields: [attachmentUploadId], references: [id])

  /// Cursor pagination: (conversation_id, created_at desc, id).
  @@index([conversationId, createdAt(sort: Desc), id])
  @@map("messages")
}

// ─────────────────────────── Notifications, views, reports, audit ───────────────────────────

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      String // verification_result, new_application, status_change, invite, interview, …
  payload   Json                @default("{}")
  channel   NotificationChannel @default(in_app)
  sentAt    DateTime?           @map("sent_at")
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Every profile view and CV view/download; feeds "X principals/directors viewed your CV this week".
model ProfileView {
  id        String          @id @default(uuid()) @db.Uuid
  teacherId String          @map("teacher_id") @db.Uuid
  viewerId  String          @map("viewer_id") @db.Uuid
  kind      ProfileViewKind
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  teacher TeacherProfile @relation(fields: [teacherId], references: [id])
  viewer  User           @relation("ProfileViewViewer", fields: [viewerId], references: [id])

  @@index([teacherId, createdAt(sort: Desc)])
  @@map("profile_views")
}

model Report {
  id           String           @id @default(uuid()) @db.Uuid
  reporterId   String           @map("reporter_id") @db.Uuid
  targetType   ReportTargetType @map("target_type")
  targetId     String           @map("target_id") @db.Uuid
  reason       String
  details      String?
  status       ReportStatus     @default(open)
  resolvedById String?          @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?        @map("resolved_at")
  resolution   String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy User? @relation("ReportResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

/// Admin actions and every admin document access.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────── Blog and ads ───────────────────────────

model Post {
  id              String     @id @default(uuid()) @db.Uuid
  authorId        String     @map("author_id") @db.Uuid
  title           String
  /// Set on first approval from the title; never changes after (CLAUDE.md SEO rules).
  slug            String?    @unique
  /// Blog category slug (reference data `blog-categories`).
  category        String?
  excerpt         String?
  body            String
  coverImageKey   String?    @map("cover_image_key")
  coverUploadId   String?    @unique @map("cover_upload_id") @db.Uuid
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  status          PostStatus @default(draft)
  /// Why an admin rejected the post (shown to the writer).
  reviewNote      String?    @map("review_note")
  submittedAt     DateTime?  @map("submitted_at")
  publishedAt     DateTime?  @map("published_at")
  /// Admin takedown after publishing (with the reason); the writer is told.
  removedReason   String?    @map("removed_reason")
  likesCount      Int        @default(0) @map("likes_count")
  commentsCount   Int        @default(0) @map("comments_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  author         User            @relation(fields: [authorId], references: [id])
  coverUpload    Upload?         @relation(fields: [coverUploadId], references: [id])
  comments       BlogComment[]
  communityPosts CommunityPost[]

  @@index([status, publishedAt])
  @@index([category, publishedAt])
  @@index([authorId])
  @@map("posts")
}

model BlogCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("blog_categories")
}

model BlogComment {
  id            String    @id @default(uuid()) @db.Uuid
  postId        String    @map("post_id") @db.Uuid
  authorId      String    @map("author_id") @db.Uuid
  body          String
  likesCount    Int       @default(0) @map("likes_count")
  removedReason String?   @map("removed_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  post   Post @relation(fields: [postId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("blog_comments")
}

/// One like per person per post or comment.
model BlogLike {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  targetType BlogLikeTarget @map("target_type")
  targetId   String         @map("target_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("blog_likes")
}

/// Admin can switch ad slots off per page type without a deploy.
model AdSettings {
  id        String     @id @default(uuid()) @db.Uuid
  pageType  AdPageType @map("page_type")
  slotName  String     @map("slot_name") // e.g. in_feed, sidebar, below_description
  enabled   Boolean    @default(false)
  slotId    String?    @map("slot_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([pageType, slotName])
  @@map("ad_settings")
}

// ─────────────────────────── Community (user, 2026-10-31) ───────────────────────────

/// Topic tags for community posts (admin-managed like subjects; deactivated, never deleted).
model CommunityTag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("community_tags")
}

/// A status post in the one shared feed. Signed-in users only (noindex, no ads).
model CommunityPost {
  id            String    @id @default(uuid()) @db.Uuid
  authorId      String    @map("author_id") @db.Uuid
  body          String
  /// Topic tag slug (optional).
  tag           String?
  /// A shared job: the card is rendered through the public vacancy serializer.
  vacancyId     String?   @map("vacancy_id") @db.Uuid
  /// A share (repost) of another post; always the original, never a share of a share.
  sharedPostId  String?   @map("shared_post_id") @db.Uuid
  /// A shared blog post (published ones only).
  blogPostId    String?   @map("blog_post_id") @db.Uuid
  likesCount    Int       @default(0) @map("likes_count")
  commentsCount Int       @default(0) @map("comments_count")
  sharesCount   Int       @default(0) @map("shares_count")
  /// Set by an admin removal (with the reason); the author is told.
  removedReason String?   @map("removed_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  author   User               @relation(fields: [authorId], references: [id])
  vacancy  Vacancy?           @relation(fields: [vacancyId], references: [id])
  shared   CommunityPost?     @relation("CommunityShares", fields: [sharedPostId], references: [id])
  blogPost Post?              @relation(fields: [blogPostId], references: [id])
  shares   CommunityPost[]    @relation("CommunityShares")
  photos   CommunityPhoto[]
  comments CommunityComment[]

  /// Feed: newest first with an id tiebreak (cursor pagination).
  @@index([createdAt(sort: Desc), id])
  @@index([tag, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([sharedPostId])
  @@map("community_posts")
}

/// Up to 4 per post; shown only once the virus scan is clean.
model CommunityPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  uploadId  String   @unique @map("upload_id") @db.Uuid
  objectKey String   @map("object_key")
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post   CommunityPost @relation(fields: [postId], references: [id])
  upload Upload        @relation(fields: [uploadId], references: [id])

  @@index([postId, position])
  @@map("community_photos")
}

model CommunityComment {
  id            String    @id @default(uuid()) @db.Uuid
  postId        String    @map("post_id") @db.Uuid
  authorId      String    @map("author_id") @db.Uuid
  body          String
  likesCount    Int       @default(0) @map("likes_count")
  removedReason String?   @map("removed_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  post   CommunityPost @relation(fields: [postId], references: [id])
  author User          @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
  @@map("community_comments")
}

enum CommunityLikeTarget {
  post
  comment
}

/// One like per user per post or comment.
model CommunityLike {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  targetType CommunityLikeTarget @map("target_type")
  targetId   String              @map("target_id") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("community_likes")
}

/// Blocking hides each side's posts and comments from the other, both ways.
model CommunityBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  blocker User @relation("CommunityBlocker", fields: [blockerId], references: [id])
  blocked User @relation("CommunityBlocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("community_blocks")
}

/// Contact form messages (user, 2026-11-01): kept for admins and emailed to SUPPORT_EMAIL.
model ContactMessage {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String
  topic     String
  message   String
  status    String    @default("open")
  /// Set when the sender was signed in.
  userId    String?   @map("user_id") @db.Uuid
  /// SHA-256 of the sender's IP (for the hourly limit; the address itself is not stored).
  ipHash    String    @map("ip_hash")
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@map("contact_messages")
}

/// A browser or installed app that allowed push alerts (user, 2026-11-01). One row per device.
model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ─────────────────────────── Resources (user, 2026-11-01; admin uploads only) ───────────────────────────

/// Lesson notes, schemes of work and other teaching materials. Listed publicly; members download.
model TeachingMaterial {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  description String
  /// lesson_note | scheme_of_work | lesson_plan | past_questions | teaching_aid
  kind        String
  /// Subject slug (reference data); optional for general material.
  subject     String?
  /// e.g. primary-4, jss-2, ss-3 (CLASS_LEVELS in shared).
  classLevel  String?   @map("class_level")
  /// first | second | third
  term        String?
  uploadId    String    @unique @map("upload_id") @db.Uuid
  objectKey   String    @map("object_key")
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  downloads   Int       @default(0)
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  upload    Upload @relation(fields: [uploadId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([subject, classLevel])
  @@index([createdAt])
  @@map("teaching_materials")
}

/// School calendar dates typed in by admins, for all of Nigeria (no state) or one state.
model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  /// resumption | midterm_break | end_of_term | public_holiday | exam | other
  kind        String
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  stateId     String?   @map("state_id") @db.Uuid
  note        String?
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  state     State? @relation(fields: [stateId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([startDate])
  @@map("calendar_events")
}

/// External exams (WAEC, NECO, JAMB...). Reference data: admins add or retire them.
model Exam {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  fullName    String   @map("full_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  timetables ExamTimetable[]

  @@map("exams")
}

/// The official timetable file for one exam sitting, uploaded by an admin. Public download.
model ExamTimetable {
  id          String    @id @default(uuid()) @db.Uuid
  examId      String    @map("exam_id") @db.Uuid
  year        Int
  /// e.g. "May/June", "Nov/Dec", "Main"
  session     String
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  uploadId    String    @unique @map("upload_id") @db.Uuid
  objectKey   String    @map("object_key")
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  exam      Exam   @relation(fields: [examId], references: [id])
  upload    Upload @relation(fields: [uploadId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([examId, year])
  @@map("exam_timetables")
}

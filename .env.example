# Copy to backend/.env and frontend/.env.local (pnpm setup:env does this for you).

# ---- App ----
APP_NAME=EDU-FORUM
APP_URL=http://localhost:3000
API_PORT=4000

# ---- Database (docker compose) ----
DATABASE_URL=postgresql://eduforum:eduforum@localhost:5432/eduforum?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Seconds in which a just-rotated refresh token may be re-presented (parallel tabs) without
# being treated as token theft.
REFRESH_REUSE_GRACE_SECONDS=10
# HMAC key for OTP codes and one-time tokens
OTP_SECRET=change-me-otp-secret-at-least-32-chars
# Max attempts per minute per IP on sign-in/sign-up/reset endpoints (PRD: 5)
AUTH_RATE_LIMIT=5
# 32-byte key (base64) used to encrypt ID document numbers at rest
DOC_NUMBER_ENCRYPTION_KEY=change-me-32-byte-base64-key
# First admin account, created by the seed if both are set
SEED_ADMIN_EMAIL=admin@edu-forum.local
SEED_ADMIN_PASSWORD=

# ---- Storage (Backblaze B2, S3-compatible API; used locally and in production) ----
# Create a private bucket and an application key at https://secure.backblaze.com
# S3_ENDPOINT looks like https://s3.<region>.backblazeb2.com (shown on the bucket page)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=600

# ---- Virus scan (ClamAV) ----
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---- Email (Mailpit locally, Resend in production) ----
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="EDU-FORUM <no-reply@edu-forum.local>"
RESEND_API_KEY=

# ---- SMS / WhatsApp (console locally, Termii in production) ----
SMS_DRIVER=console
TERMII_API_KEY=

# ---- Geocoding (stub locally, Google in production) ----
GEOCODER_DRIVER=stub
GOOGLE_GEOCODING_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_APP_NAME=EDU-FORUM
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADSENSE_CLIENT=

# Copy to backend/.env and frontend/.env.local (pnpm setup:env does this for you).

# ---- App ----
APP_NAME=EDU-FORUM
APP_URL=http://localhost:3000
API_PORT=4000

# ---- Database (docker compose) ----
DATABASE_URL=postgresql://eduforum:eduforum@localhost:5432/eduforum?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte key (base64) used to encrypt ID document numbers at rest
DOC_NUMBER_ENCRYPTION_KEY=change-me-32-byte-base64-key

# ---- Storage (MinIO locally, Cloudflare R2 in production) ----
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=eduforum-private
S3_ACCESS_KEY=eduforum
S3_SECRET_KEY=eduforum-secret
SIGNED_URL_TTL_SECONDS=600

# ---- Virus scan (ClamAV) ----
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---- Email (Mailpit locally, Resend in production) ----
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="EDU-FORUM <no-reply@edu-forum.local>"
RESEND_API_KEY=

# ---- SMS / WhatsApp (console locally, Termii in production) ----
SMS_DRIVER=console
TERMII_API_KEY=

# ---- Geocoding (stub locally, Google in production) ----
GEOCODER_DRIVER=stub
GOOGLE_GEOCODING_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_APP_NAME=EDU-FORUM
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADSENSE_CLIENT=
